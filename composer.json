{
    "name": "sartajgit/laravel-query-xray",
    "description": "Real-time N+1, slow query, duplicate query and unoptimized query detection dashboard for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sartajgit\\QueryXray\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sartajgit\\QueryXray\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sartajgit\\QueryXray\\QueryXrayServiceProvider"
            ]
        }
    }
}